# ── Frontend environment variables ────────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# Only VITE_ prefixed vars are exposed to the browser bundle.
# ──────────────────────────────────────────────────────────────────────────────

# World App application ID (from https://developer.worldcoin.org)
# TODO: PRODUCTION - replace with your real app ID
VITE_WLD_APP_ID=app_ac9f43a974959b04b11b081c3740f932

# World ID Action IDs (must match Developer Portal and backend .env)
VITE_WLD_LOGIN_ACTION_ID=wld2mpesa-login
VITE_WLD_PAY_ACTION_ID=wld2mpesa-pay

# Backend API base URL
# Leave as /api when using the Vite proxy (local dev) or nginx proxy (Docker prod).
# Set to the full backend URL only if you are NOT using a proxy.
# Example (direct): VITE_BACKEND_URL=http://localhost:3001/api
VITE_BACKEND_URL=/api
