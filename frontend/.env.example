# ── Frontend environment variables ────────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# Only VITE_ prefixed vars are exposed to the browser bundle.
# ──────────────────────────────────────────────────────────────────────────────

# World App application ID (from https://developer.worldcoin.org)
# [REQUIRED IN PRODUCTION] Replace with your real app ID.
VITE_WLD_APP_ID=app_c3d72bbb27b58ee83b91a1207fe022f6

# [REQUIRED IN PRODUCTION] Relying Party ID — from Developer Portal → Apps → your app → Relying Party.
# Required for World ID 4.0 IDKit verification; omitting this causes silent auth failures.
VITE_WLD_RP_ID=rp_649206d681cef068

# World ID Action IDs (must match Developer Portal and backend .env)
VITE_WLD_LOGIN_ACTION_ID=wld2cash-auth
VITE_WLD_PAY_ACTION_ID=wld2cash-pay

# Backend API base URL
# Leave as /api when using the Vite proxy (local dev) or nginx proxy (Docker prod).
# Set to the full backend URL only if you are NOT using a proxy.
# Example (direct): VITE_BACKEND_URL=http://localhost:3001/api
VITE_BACKEND_URL=/api
