# ── Backend environment variables ─────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# Lines marked [REQUIRED IN PRODUCTION] must be set before going live.
# ──────────────────────────────────────────────────────────────────────────────

# Server
PORT=3001
NODE_ENV=development

# CORS allowed origin (comma-separated for multiple, or * for any)
# In production behind nginx, this can stay as * since nginx proxies same-origin.
CORS_ORIGIN=*

# DATABASE_URL for Prisma (SQLite: file:./prisma/dev.db)
DATABASE_URL=file:./dev.db

# ── Fee config ─────────────────────────────────────────────────────────────────
FEE_PERCENT=0.5
MIN_KES_AMOUNT=10
MAX_KES_AMOUNT=150000

# ── World App / MiniKit ────────────────────────────────────────────────────────
# [REQUIRED IN PRODUCTION] From https://developer.worldcoin.org
WLD_APP_ID=app_ac9f43a974959b04b11b081c3740f932
WLD_SIGNING_KEY=
WLD_LOGIN_ACTION_ID=wld2mpesa-login
WLD_PAY_ACTION_ID=wld2mpesa-pay

# ── World Chain wallet ─────────────────────────────────────────────────────────
# [REQUIRED IN PRODUCTION] Escrow wallet that receives WLD from users
BACKEND_WALLET_ADDRESS=0xSIMULATED_BACKEND_WALLET
# [REQUIRED IN PRODUCTION] Never commit this value
BACKEND_WALLET_PRIVATE_KEY=

# ── World Chain RPC ────────────────────────────────────────────────────────────
# [REQUIRED IN PRODUCTION] e.g. https://worldchain-mainnet.g.alchemy.com/v2/KEY
WORLD_CHAIN_RPC_URL=

# ── Off-ramp: Bitnob ─────────────────────────────────────────────────────────
# [REQUIRED IN PRODUCTION] https://bitnob.com/
BITNOB_API_KEY=
BITNOB_ENV=sandbox

# ── DEX Swap Admin ───────────────────────────────────────────────────────────
# For automated rebalancing (WLD -> USDC)
ADMIN_PRIVATE_KEY=

# ── M-Pesa Daraja API ─────────────────────────────────────────────────────────
# [REQUIRED IN PRODUCTION] https://developer.safaricom.co.ke
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_ENV=sandbox
MPESA_SHORTCODE=174379
MPESA_B2B_SHORTCODE=600000
MPESA_INITIATOR_NAME=testapi
MPESA_PASSKEY=

# ── Backend public URL (for M-Pesa callbacks) ──────────────────────────────────
# [REQUIRED IN PRODUCTION] Your deployed URL, e.g. https://wld2mpesa.onrender.com
BACKEND_URL=http://localhost:3001
