// Database: PostgreSQL
// ──────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client"
  output   = "../.generated/postgres_client"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

// ─── User ─────────────────────────────────────────────────────────────────────

model User {
  id                String   @id @default(uuid())
  walletAddress     String   @unique @map("wallet_address")
  nullifierHash     String?  @unique @map("nullifier_hash")
  name              String?
  verificationLevel String?  @map("verification_level") // "orb" | "device"
  isVerified        Boolean  @default(false) @map("is_verified")
  onboarded         Boolean  @default(false)
  createdAt         DateTime @default(now()) @map("created_at")
  lastSeenAt        DateTime @default(now()) @map("last_seen_at")

  transactions Transaction[]

  @@map("users")
}

// ─── Transaction ──────────────────────────────────────────────────────────────

model Transaction {
  id              String   @id // "TXN-{timestamp}-{uuid4_short}"
  status          String   @default("INITIATED")
  transactionType String   @map("transaction_type") // send | paybill | pochi | till

  // Amounts
  kesAmount  Float  @map("kes_amount")
  wldAmount  String @map("wld_amount")
  feeWld     String @map("fee_wld")
  feeKes     Float  @map("fee_kes")
  wldRate    String @map("wld_rate")

  // Platform cost tracking (internal — not shown to users)
  platformFeeKes Float? @map("platform_fee_kes")   // Our 5% service revenue
  safaricomFeeKes Float? @map("safaricom_fee_kes")  // M-Pesa pass-through cost
  gasBufferKes   Float? @map("gas_buffer_kes")      // World Chain L2 ETH gas
  bitnobFeeKes   Float? @map("bitnob_fee_kes")      // Bitnob spread (~2.2% of kesAmount)
  dexFeeKes      Float? @map("dex_fee_kes")         // Uniswap 0.3% pool fee on swap
  netPlatformRevenueKes Float? @map("net_platform_revenue_kes") // platformFee - all platform costs

  // Recipient details
  tillNumber    String? @map("till_number")
  phoneNumber   String? @map("phone_number")
  accountNumber String? @map("account_number")

  // Wallet
  walletAddress String @map("wallet_address")
  payToAddress  String @map("pay_to_address")

  // Chain / service references
  txHash              String? @map("tx_hash")
  offrampId           String? @map("offramp_id")
  mpesaConversationId String? @map("mpesa_conversation_id")
  mpesaReceiptNumber  String? @map("mpesa_receipt_number")

  // Failure
  failureReason String? @map("failure_reason")

  // Refund tracking
  refundStatus String? @map("refund_status") // REFUND_INITIATED | REFUNDED | REFUND_FAILED
  refundTxHash String? @map("refund_tx_hash")
  refundAt     DateTime? @map("refund_at")

  // Audit payloads (stored as JSON strings)
  miniKitPayload String? @map("minikit_payload")
  worldIdProof   String? @map("world_id_proof")

  // Timestamps
  createdAt   DateTime  @default(now()) @map("created_at")
  confirmedAt DateTime? @map("confirmed_at")
  offrampAt   DateTime? @map("offramp_at")
  mpesaSentAt DateTime? @map("mpesa_sent_at")
  settledAt   DateTime? @map("settled_at")
  failedAt    DateTime? @map("failed_at")

  // Relations
  userId String? @map("user_id")
  user   User?   @relation(fields: [userId], references: [id])

  webhookEvents WebhookEvent[]

  @@index([walletAddress])
  @@index([status])
  @@map("transactions")
}

// ─── Rate Cache ───────────────────────────────────────────────────────────────

model RateCache {
  id          Int      @id @default(autoincrement())
  wldPriceKes Float    @map("wld_price_kes")
  wldPriceUsd Float    @map("wld_price_usd")
  usdKesRate  Float    @map("usd_kes_rate")
  source      String   @default("coingecko")
  fetchedAt   DateTime @default(now()) @map("fetched_at")

  @@map("rate_cache")
}

// ─── Webhook Events (audit trail) ─────────────────────────────────────────────

model WebhookEvent {
  id            String    @id @default(uuid())
  source        String    // "mpesa" | "yellowcard"
  eventType     String    @map("event_type")
  rawPayload    String    @map("raw_payload") // JSON string
  processedAt   DateTime? @map("processed_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  // Relations
  transactionId String?      @map("transaction_id")
  transaction   Transaction? @relation(fields: [transactionId], references: [id])

  @@index([transactionId])
  @@map("webhook_events")
}

// ─── Contact Messages ─────────────────────────────────────────────────────────

model ContactMessage {
  id            String   @id @default(uuid())
  name          String
  email         String
  company       String?
  inquiryType   String   @map("inquiry_type") // demo | support | partnership | other
  message       String
  status        String   @default("NEW") // NEW | READ | REPLIED | RESOLVED | ARCHIVED
  ipAddress     String?  @map("ip_address")
  userAgent     String?  @map("user_agent")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  conversation  Conversation?

  @@index([email])
  @@index([status])
  @@index([createdAt])
  @@map("contact_messages")
}

// ─── Conversations (grouped messages with a contact) ──────────────────────────

model Conversation {
  id              String   @id @default(uuid())
  contactEmail    String   @map("contact_email")
  contactName     String   @map("contact_name")
  contactCompany  String?  @map("contact_company")
  status          String   @default("ACTIVE") // ACTIVE | CLOSED | ARCHIVED
  lastMessageAt   DateTime @default(now()) @map("last_message_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  originalMessageId String         @unique @map("original_message_id")
  originalMessage   ContactMessage @relation(fields: [originalMessageId], references: [id])
  messages          Message[]
  assignedAdminId   String?        @map("assigned_admin_id")
  assignedAdmin     Admin?         @relation(fields: [assignedAdminId], references: [id])

  @@index([contactEmail])
  @@index([status])
  @@index([lastMessageAt])
  @@map("conversations")
}

// ─── Messages (conversation thread) ───────────────────────────────────────────

model Message {
  id              String   @id @default(uuid())
  conversationId  String   @map("conversation_id")
  senderType      String   @map("sender_type") // CONTACT | ADMIN | SYSTEM
  senderId        String?  @map("sender_id") // Admin ID if sender is admin
  content         String
  isEmailSent     Boolean  @default(false) @map("is_email_sent")
  emailSentAt     DateTime? @map("email_sent_at")
  emailError      String?  @map("email_error")
  createdAt       DateTime @default(now()) @map("created_at")

  // Relations
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender          Admin?       @relation(fields: [senderId], references: [id])

  @@index([conversationId])
  @@index([createdAt])
  @@map("messages")
}

// ─── Admins ─────────────────────────────────────────────────────────────────────

model Admin {
  id            String   @id @default(uuid())
  fullName      String   @map("full_name")
  email         String   @unique
  phone         String?
  passwordHash  String   @map("password_hash")
  role          String   @default("MANAGER") // SUPER_ADMIN | MANAGER
  status        String   @default("ACTIVE") // ACTIVE | SUSPENDED | INACTIVE
  lastLoginAt   DateTime? @map("last_login_at")
  lastLoginIp   String?   @map("last_login_ip")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  conversations Conversation[]
  messages      Message[]
  sentInvitations AdminInvitation[] @relation("InvitedBy")

  @@index([email])
  @@index([role])
  @@index([status])
  @@map("admins")
}

// ─── Admin Invitations ─────────────────────────────────────────────────────────

model AdminInvitation {
  id            String   @id @default(uuid())
  email         String
  fullName      String   @map("full_name")
  phone         String?
  role          String   @default("MANAGER") // MANAGER only (SUPER_ADMIN via script only)
  token           String   @unique
  expiresAt       DateTime @map("expires_at")
  acceptedAt      DateTime? @map("accepted_at")
  createdAt       DateTime @default(now()) @map("created_at")

  // Relations
  invitedById     String   @map("invited_by_id")
  invitedBy       Admin    @relation("InvitedBy", fields: [invitedById], references: [id])

  @@index([token])
  @@index([email])
  @@index([expiresAt])
  @@map("admin_invitations")
}
