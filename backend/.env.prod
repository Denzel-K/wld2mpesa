# ── Backend environment variables ─────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# Lines marked [REQUIRED IN PRODUCTION] must be set before going live.
# ──────────────────────────────────────────────────────────────────────────────

# Server
PORT=3001
NODE_ENV=development

# CORS allowed origin — in production set to your actual mini-app origin.
# World App loads mini-apps from https://worldcoin.org or your custom domain.
# Example: CORS_ORIGIN=https://your-mini-app-domain.com
CORS_ORIGIN=*

# ── Backend public URL ─────────────────────────────────────────────────────────
# [REQUIRED IN PRODUCTION] Your deployed backend URL (used for Bitnob webhook registration).
# Example: BACKEND_URL=https://api.wld2cash.app
BACKEND_URL=http://localhost:3001
REDIS_URL="rediss://default:gQAAAAAAAoDGAAIgcDIzNDZhMmY3N2I0NDY0NTc3ODQyMWVjN2YyYjZhOWRiZQ@major-foal-164038.upstash.io:6379"
CLOUDFLARE_ENABLED="false"

# ── Database ───────────────────────────────────────────────────────────────────
# [REQUIRED IN PRODUCTION] PostgreSQL connection string
# Example: postgresql://USER:PASSWORD@HOST:PORT/DB?schema=public
DATABASE_URL="postgresql://neondb_owner:npg_TCZ4veQx9Mri@ep-misty-haze-b574ksl4-pooler.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# ── Fee config ─────────────────────────────────────────────────────────────────
FEE_PERCENT=0.5
MIN_KES_AMOUNT=10
MAX_KES_AMOUNT=150000

# ── World App / MiniKit ────────────────────────────────────────────────────────
# [REQUIRED IN PRODUCTION] From https://developer.worldcoin.org
WLD_APP_ID=app_ac9f43a974959b04b11b081c3740f932
WLD_RP_ID=rp_c205808e8673f770
WLD_SIGNING_KEY=0x143B40063b36A9fAC3F88E0763e9D9057A50d5c4
WLD_LOGIN_ACTION_ID=wld2mpesa-login
WLD_PAY_ACTION_ID=wld2mpesa-pay

# ── World Chain wallet ─────────────────────────────────────────────────────────
# [REQUIRED IN PRODUCTION] Escrow wallet that receives WLD from users.
# BACKEND_WALLET_ADDRESS: the public address shown in your World App wallet.
# BACKEND_WALLET_PRIVATE_KEY: the private key that controls that address.
#   → In World App: Settings → Wallet → Export Private Key
#   → Never share or commit this to version control.
BACKEND_WALLET_ADDRESS=0xCc6849c696A440B58D5BA9c924686102F1CcC850
BACKEND_WALLET_PRIVATE_KEY=e42c03bc4306cc90d2575a2116bf30cd36a251141f02c3cac533d899c0227fea

# ── World Chain RPC ────────────────────────────────────────────────────────────
# [REQUIRED IN PRODUCTION] e.g. https://worldchain-mainnet.g.alchemy.com/v2/KEY
WORLD_CHAIN_RPC_URL=https://worldchain-mainnet.g.alchemy.com/v2/tMGCTnXntcBZF8Lf_495t

# ── DEX Swap Admin ────────────────────────────────────────────────────────────
# [REQUIRED IN PRODUCTION] Private key of the escrow/swap wallet.
# This MUST be the private key matching BACKEND_WALLET_ADDRESS — NOT the address itself.
# The swap wallet must hold enough ETH on World Chain to pay gas (~0.001 ETH/tx).
ADMIN_PRIVATE_KEY=e42c03bc4306cc90d2575a2116bf30cd36a251141f02c3cac533d899c0227fea

# ── Kraken rate API ───────────────────────────────────────────────────────────
# Optional — free public Kraken endpoint used by default (no key required).
KRAKEN_API_KEY=fuTxlFv6hBn5l/oi3p7xQeZz3mNutdpj8D10inrhJiR6ngJp7BxcIHrr
KRAKEN_API_SECRET=ndbpc2hIXcDA1hHqAyaPlcB7XclEKEhpPow04Ii6KUITdwl8iKfbKBFxwH4Yjt7g+KUcmD+Fz1D5ow528U056Q==

# ── Off-ramp: Bitnob ──────────────────────────────────────────────────────────
# Bitnob handles ALL disbursements: send money, Pochi la Biashara, Till, Paybill.
# Dashboard: https://app.bitnob.com → Settings → API Keys
#
# BITNOB_CLIENT_ID   : copied from "Client ID" field in your Bitnob API Keys page
# BITNOB_SECRET_KEY  : copied from "Secret Key" field in your Bitnob API Keys page
# BITNOB_API_KEY     : use the prd:live_* key for production, prd:sandbox_* for testing
#
# [REQUIRED IN PRODUCTION] Switch these to your live credentials before launch:
BITNOB_API_KEY=prd:sandbox_6eb80028454d4bd65197f95cddcfdd7a0e39fee0de5a3f6150747112a9ff2818
# BITNOB_API_KEY=prd:live_477b9e41d374b5fed78bd824720294c9e0ad62ce6d88ff4dd8e6c0c647f809fc
BITNOB_CLIENT_ID=4f852dff-94e9-4bf9-869a-862b99dab5a2
BITNOB_SECRET_KEY=prd:sandbox_6eb80028454d4bd65197f95cddcfdd7a0e39fee0de5a3f6150747112a9ff2818
# Switch to 'production' when using live keys:
BITNOB_ENV=sandbox

