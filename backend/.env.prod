# ── Website URL (for admin invitation links) ───────────────────────────────────
# [REQUIRED IN PRODUCTION] Set to your deployed admin panel / website URL.
# Example: WEBSITE_URL=https://admin.wld2cash.app
WEBSITE_URL=http://localhost:4000
